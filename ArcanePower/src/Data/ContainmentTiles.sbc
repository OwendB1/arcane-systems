<Definitions>
  <Components>
    <Component>
      <Id>
        <TypeId>Component</TypeId>
        <SubtypeId>ArcaneContainmentTile</SubtypeId>
      </Id>
      <DisplayName>Standard Containment Tile</DisplayName>
      <Icon>Textures/GUI/Icons/ArcaneContainmentTile.dds</Icon>
      <Size>
        <X>0.54</X>
        <Y>0.4</Y>
        <Z>0.045</Z>
      </Size>
      <Mass>1</Mass>
      <Volume>2</Volume>
      <Model>Models/Cubes/large/ArcanePower_ContainmentTile.mwm</Model>
      <PhysicalMaterial>Metal</PhysicalMaterial>
      <MaxIntegrity>30</MaxIntegrity>
      <DropProbability>0.5</DropProbability>
      <Health>18</Health>
      <Description>Self-controlling platinum-lined containment with superconducting coils, onboard computers and quartet sensing. Compatible with Aether, Helion and Empyrean. 1x Standard lifetime and crafting cost. Install in same-grade quartets; the shell holds 80 tiles. Normal shutdown retains tiles; venting discards them.</Description>
    </Component>
