<?xml version='1.0' encoding='utf-8'?>
<Definitions>
  <CubeBlocks>
    <Definition>
      <Id>
        <TypeId>Conveyor</TypeId>
        <SubtypeId>ArcanePower_VentDuct</SubtypeId>
      </Id>
      <DisplayName>Arcane Vent Duct</DisplayName>
      <Icon>Textures/GUI/Icons/ArcaneVentDuct.dds</Icon>
      <Description>VENT ROUTE
Stack 1-15 Arcane Vent Ducts above the centered reactor roof hatch.
Finish with one Arcane Vent Outlet and keep the outlet clear.

INSTALLATION
Fully weld every section on the same grid.
Align their top faces with reactor Up.
Central ports also carry conveyor items.

SAFETY
Missing or damaged sections prevent startup.
Security mode selects shutdown or warning on vent loss after startup.</Description>
      <GuiVisible>true</GuiVisible>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="1" z="3" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/reactor_1f5ea788d1ef/ArcanePower_VentDuct.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="180" />
        <Component Subtype="InteriorPlate" Count="40" />
        <Component Subtype="Construction" Count="120" />
        <Component Subtype="MetalGrid" Count="40" />
        <Component Subtype="LargeTube" Count="40" />
        <Component Subtype="SmallTube" Count="40" />
        <Component Subtype="Computer" Count="16" />
        <Component Subtype="Motor" Count="16" />
        <Component Subtype="InteriorPlate" Count="40" />
        <Component Subtype="SteelPlate" Count="60" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <BlockPairName>ArcanePower_VentDuct</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>30</BuildTimeSeconds>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <EmissiveColorPreset>ArcaneVentDisconnected</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyed_Large</DestroyEffect>
      <DestroySound>PoofExplosionCat3</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
      <Center x="1" y="0" z="1" />
      <MountPoints>
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="3" EndY="0.65" />
        <MountPoint Side="Top" StartX="0" StartY="2.35" EndX="3" EndY="3" />
        <MountPoint Side="Top" StartX="0" StartY="0.65" EndX="0.65" EndY="2.35" />
        <MountPoint Side="Top" StartX="2.35" StartY="0.65" EndX="3" EndY="2.35" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="0.65" />
        <MountPoint Side="Bottom" StartX="0" StartY="2.35" EndX="3" EndY="3" />
        <MountPoint Side="Bottom" StartX="0" StartY="0.65" EndX="0.65" EndY="2.35" />
        <MountPoint Side="Bottom" StartX="2.35" StartY="0.65" EndX="3" EndY="2.35" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="3" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="3" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="3" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
