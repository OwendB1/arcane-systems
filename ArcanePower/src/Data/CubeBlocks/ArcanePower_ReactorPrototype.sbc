<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_ReactorDefinition">
      <Id>
        <TypeId>Reactor</TypeId>
        <SubtypeId>ArcanePower_ReactorPrototype</SubtypeId>
      </Id>
      <DisplayName>Arcane Power Reactor — Prototype</DisplayName>
      <Icon>Textures\GUI\Icons\Cubes\nuclear_reactor.dds</Icon>
      <Description>Arcane Fuel I: 10 GW with two rings. Fuel II: 100 GW with three rings. Fuel III: 1 TW with four rings. Two containment controllers required. Venting ejects containment through the conveyor-connected top hatch, damages the reactor/modules, and leaves the reactor off.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="5" y="3" z="5" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/ArcanePower_ReactorPrototype.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="50" />
