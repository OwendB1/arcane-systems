    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_Thermal_AtmosphericCooler</SubtypeId>
      </Id>
      <DisplayName>Arcane Atmospheric cooler</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_AtmosphericCooler.dds</Icon>
      <Description>5 GW ideal heat rejection per unit/panel.

INSTALLATION
Airtight hull casing, rear manifold.
Keep 2.5 m clear beyond both exhaust fans.
Requires reactor auxiliary power for active cooling.

ENVIRONMENT
Zero cooling in vacuum; full rating at 1 atmosphere.
Half-clear exhaust gives 25% cooling; blocked gives none.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="3" z="2" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_AtmosphericCooler_M.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="36" />
        <Component Subtype="Construction" Count="18" />
        <Component Subtype="LargeTube" Count="9" />
        <Component Subtype="Motor" Count="12" />
        <Component Subtype="Computer" Count="15" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BlockPairName>ArcanePower_Thermal_AtmosphericCooler</BlockPairName>
      <EdgeType>Light</EdgeType>
      <Upgrades />
      <PrimarySound />
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>30</PCU>
      <IsAirTight>true</IsAirTight>
      <BuildProgressModels>
        <Model BuildPercentUpperBound=".33" File="Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_AtmosphericCooler_M_BS1.mwm" />
        <Model BuildPercentUpperBound=".67" File="Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_AtmosphericCooler_M_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_AtmosphericCooler_M_BS3.mwm" />
      </BuildProgressModels>
      <Public>true</Public>
