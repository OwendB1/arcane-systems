    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_Thermal_PrimaryHeater</SubtypeId>
      </Id>
      <DisplayName>Arcane Primary heater</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_PrimaryHeater.dds</Icon>
      <Description>Closed-loop thermal Primary heater. Match typed socket faces and H/C roll on one physical large grid. Use the placement guide and cap unused sockets. The reactor supplies its own CO2; ordinary conveyors do not replace thermal pipes.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="3" z="3" />
