    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_Thermal_RadiatorPanel</SubtypeId>
      </Id>
      <DisplayName>Arcane Radiator panel</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_RadiatorPanel.dds</Icon>
      <Description>10 GW ideal heat rejection per unit/panel. Aim at the top shaft coupling and stack directly above a radiator or its first extension on the same grid. Match the base Up axis; any yaw works. Moving panels align automatically. Maximum two extensions. Grind either panel face to remove a section. Each panel provides 100% cooling in shade or edge-on, 50% in full sun; unattached panels provide no cooling.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="2" z="3" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/Thermal/thermal_24e660488b5a/APT_RadiatorPanel_M.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="36" />
        <Component Subtype="Construction" Count="18" />
        <Component Subtype="LargeTube" Count="9" />
        <Component Subtype="Motor" Count="12" />
        <Component Subtype="Computer" Count="15" />
        <Component Subtype="SteelPlate" Count="4" />
