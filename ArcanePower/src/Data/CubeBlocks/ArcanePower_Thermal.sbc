    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_Thermal_SpaceRadiator</SubtypeId>
      </Id>
      <DisplayName>Arcane Space radiator</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_SpaceRadiator.dds</Icon>
      <Description>10 GW ideal heat rejection per unit/panel. Bottom socket; automatic edge-on sun tracking. Zero solar exposure gives 100% cooling; full sun on either face gives 50%. Angle, shade and weather follow solar-panel exposure. Stack up to two aligned panels on the same grid. Mixed tiers add their own cooling. Keep both faces exposed to space.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="3" z="3" />
      <ModelOffset x="0" y="0" z="0" />
