<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_ReactorDefinition">
      <Id>
        <TypeId>Reactor</TypeId>
        <SubtypeId>ArcanePower_Thermal_BraytonTrain</SubtypeId>
      </Id>
      <DisplayName>Arcane Turbine</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_BraytonTrain.dds</Icon>
      <Description>OUTPUT
3.5 GW electrical ceiling per turbine.
Helion: 3.5 GW electrical and cooling load per circuit; 14 GW across four.
Aether: 1 GW electrical and cooling load per circuit; 4 GW across four.
Brayton: flat 80% fuel conversion. Cooling load equals delivered electricity.

FUELS
T1/T2 fuels only; T3 Empyrean requires upgraded turbines.

INSTALLATION
2 wide x 2 high x 5 long large-grid turbine/compressor.
One lower-cell duplex H/C socket; mirrored versions move it to the opposite side.

CIRCUIT
Connect exactly one turbine and cooling per reactor manifold.
Keep the four circuits separate; each receives up to 25% of reactor heat.
The reactor supplies CO2 internally.
Running auxiliaries are included in conversion efficiency.
Keep reactor auxiliary power available for active coolers during cooldown.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="5" y="2" z="2" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_BraytonTrain_M.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="60" />
        <Component Subtype="Construction" Count="30" />
        <Component Subtype="LargeTube" Count="15" />
        <Component Subtype="Motor" Count="12" />
        <Component Subtype="Computer" Count="15" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BlockPairName>ArcanePower_Thermal_BraytonTrain</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>40</BuildTimeSeconds>
      <ResourceSourceGroup>Reactors</ResourceSourceGroup>
      <MaxPowerOutput>3500</MaxPowerOutput>
      <InventorySize>
        <X>2</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <InventoryFillFactorMin>0.0005</InventoryFillFactorMin>
      <InventoryFillFactorMax>0.001</InventoryFillFactorMax>
      <FuelPullAmountFromConveyorInMinutes>10.0</FuelPullAmountFromConveyorInMinutes>
      <FuelInfos />
      <PrimarySound />
      <DamageEffectName>Damage_Reactor_Damaged</DamageEffectName>
      <DamagedSound>ParticleReactor</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>80</PCU>
      <IsAirTight>false</IsAirTight>
      <TieredUpdateTimes>
        <unsignedInt>900</unsignedInt>
        <unsignedInt>1800</unsignedInt>
        <unsignedInt>3600</unsignedInt>
      </TieredUpdateTimes>
      <TargetingGroups>
        <string>PowerSystems</string>
      </TargetingGroups>
      <FuelProductionToCapacityMultiplier>3600</FuelProductionToCapacityMultiplier>
      <BuildProgressModels>
        <Model BuildPercentUpperBound=".33" File="Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_BraytonTrain_M_BS1.mwm" />
        <Model BuildPercentUpperBound=".67" File="Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_BraytonTrain_M_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/Thermal/thermal_7ebca2a08762/APT_BraytonTrain_M_BS3.mwm" />
      </BuildProgressModels>
      <Public>true</Public>
      <AvailableInSurvival>true</AvailableInSurvival>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_ReactorDefinition">
