    <Definition xsi:type="MyObjectBuilder_ReactorDefinition">
      <Id>
        <TypeId>Reactor</TypeId>
        <SubtypeId>ArcanePower_Thermal_ReactorHousing</SubtypeId>
      </Id>
      <DisplayName>Arcane Reactor</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_ReactorHousing.dds</Icon>
      <Description>Internal CO2 generation. Standalone: 20% net. Brayton: 40% starter, up to 78% with turbine tier and cooling. Branch turbines and coolers from one shared duplex pipe network; align H/C on every face. Two containment controllers and a working vent route required. Stop and cool before changing mode.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="5" y="3" z="5" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/Thermal/thermal_ea66c7e8c915/APT_ReactorHousing_M.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="2400" />
        <Component Subtype="Construction" Count="1000" />
        <Component Subtype="MetalGrid" Count="600" />
        <Component Subtype="LargeTube" Count="240" />
        <Component Subtype="Reactor" Count="2000" />
        <Component Subtype="Motor" Count="200" />
        <Component Subtype="Superconductor" Count="1500" />
        <Component Subtype="BulletproofGlass" Count="160" />
        <Component Subtype="Computer" Count="400" />
        <Component Subtype="SteelPlate" Count="600" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BlockPairName>ArcanePower_Thermal_ReactorHousing</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>40</BuildTimeSeconds>
      <ResourceSourceGroup>Reactors</ResourceSourceGroup>
      <MaxPowerOutput>10000</MaxPowerOutput>
      <InventorySize>
        <X>2</X>
        <Y>1</Y>
        <Z>1</Z>
      </InventorySize>
      <InventoryFillFactorMin>0.0005</InventoryFillFactorMin>
      <InventoryFillFactorMax>0.001</InventoryFillFactorMax>
      <FuelPullAmountFromConveyorInMinutes>10.0</FuelPullAmountFromConveyorInMinutes>
      <FuelInfos />
      <PrimarySound />
      <DamageEffectName>Damage_Reactor_Damaged</DamageEffectName>
      <DamagedSound>ParticleReactor</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>100</PCU>
      <IsAirTight>false</IsAirTight>
      <TieredUpdateTimes>
        <unsignedInt>900</unsignedInt>
        <unsignedInt>1800</unsignedInt>
        <unsignedInt>3600</unsignedInt>
      </TieredUpdateTimes>
      <TargetingGroups>
        <string>PowerSystems</string>
      </TargetingGroups>
      <FuelProductionToCapacityMultiplier>3600</FuelProductionToCapacityMultiplier>
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="5" EndY="5" />
        <MountPoint Side="Top" StartX="1.2916" EndX="3.7084" StartY="0.3160" EndY="0.6280" />
        <MountPoint Side="Top" StartX="0.8491" EndX="4.1509" StartY="0.6280" EndY="0.9400" />
        <MountPoint Side="Top" StartX="0.5516" EndX="4.4484" StartY="0.9400" EndY="1.2520" />
        <MountPoint Side="Top" StartX="0.3384" EndX="4.6616" StartY="1.2520" EndY="1.5640" />
        <MountPoint Side="Top" StartX="0.1861" EndX="4.8139" StartY="1.5640" EndY="1.8760" />
        <MountPoint Side="Top" StartX="0.0833" EndX="4.9167" StartY="1.8760" EndY="2.1880" />
        <MountPoint Side="Top" StartX="0.0236" EndX="4.9764" StartY="2.1880" EndY="2.5000" />
        <MountPoint Side="Top" StartX="0.0236" EndX="4.9764" StartY="2.5000" EndY="2.8120" />
        <MountPoint Side="Top" StartX="0.0833" EndX="4.9167" StartY="2.8120" EndY="3.1240" />
        <MountPoint Side="Top" StartX="0.1861" EndX="4.8139" StartY="3.1240" EndY="3.4360" />
        <MountPoint Side="Top" StartX="0.3384" EndX="4.6616" StartY="3.4360" EndY="3.7480" />
        <MountPoint Side="Top" StartX="0.5516" EndX="4.4484" StartY="3.7480" EndY="4.0600" />
        <MountPoint Side="Top" StartX="0.8491" EndX="4.1509" StartY="4.0600" EndY="4.3720" />
        <MountPoint Side="Top" StartX="1.2916" EndX="3.7084" StartY="4.3720" EndY="4.6840" />
        <MountPoint Side="Front" StartX="2" EndX="3" StartY="0" EndY="1" />
        <MountPoint Side="Back" StartX="2" EndX="3" StartY="0" EndY="1" />
