    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_Thermal_RadiatorPanel</SubtypeId>
      </Id>
      <DisplayName>Arcane Radiator panel</DisplayName>
      <Icon>Textures/GUI/Icons/ArcanePower/Thermal/ArcanePower_Thermal_RadiatorPanel.dds</Icon>
      <Description>10 GW ideal heat rejection per unit/panel. Attach directly above a radiator or its first extension on the same grid. Each panel has its own solar exposure: 100% cooling in shade or edge-on, 50% in full sun. Shares base rotation; maximum two extensions. Unattached panels provide no cooling.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="2" z="3" />
      <ModelOffset x="0" y="0" z="0" />
