<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_BatteryBlockDefinition">
      <Id>
        <TypeId>BatteryBlock</TypeId>
        <SubtypeId>ArcanePower_EnergyCore_Pillar</SubtypeId>
      </Id>
      <DisplayName>Arcane Energy Core</DisplayName>
      <Description>3x3x3 storage controller. Upright 1x3x1 pillars: sides capacity; rear transfer; front stabilizer. Align module Up with core Up and its connector/forward face toward the core. Base 1,000 MWh / 10 GW; capacities add 10,000 or 100,000 MWh. Transfer modules raise the bank ceiling to 100 GW / 1 TW. Standard/advanced stabilizers support matching or lower tier modules. Native Auto/Recharge/Discharge. Starts empty; 90% charge efficiency. Default 10% emergency reserve; Custom Data [ArcaneEnergyCore] ReservePercent=10, EmergencySupport=true. Recharge switches visibly to Auto for reactor startup/cooldown/venting and stays Auto. Stored-charge upkeep rises with fill; stabilizers reduce loss. Terminal/toolbar: surge one jump drive in 5-10 seconds at 90% efficiency, or double discharge for 10 seconds. Shared recovery; reserve protected. Passive loss continues while disabled or detached.</Description>
      <Icon>Textures/GUI/Icons/ArcanePower/ArcanePower_EnergyCore.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Model>Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCore.mwm</Model>
      <BlockPairName>ArcanePower_EnergyCore_Pillar</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>180</BuildTimeSeconds>
      <PCU>100</PCU>
      <IsAirTight>false</IsAirTight>
      <Public>true</Public>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>PoofExplosionCat3</DestroySound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <Size x="3" y="3" z="3" />
      <Center x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Components>
        <Component Subtype="SteelPlate" Count="1000" />
        <Component Subtype="Construction" Count="500" />
        <Component Subtype="PowerCell" Count="1200" />
        <Component Subtype="Superconductor" Count="1000" />
        <Component Subtype="Computer" Count="200" />
        <Component Subtype="Motor" Count="80" />
        <Component Subtype="SteelPlate" Count="200" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCore_BS1.mwm" />
        <Model BuildPercentUpperBound="0.67" File="Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCore_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCore_BS3.mwm" />
      </BuildProgressModels>
      <MountPoints>
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="3" />
      </MountPoints>
      <ResourceSourceGroup>Battery</ResourceSourceGroup>
      <MaxPowerOutput>2000000</MaxPowerOutput>
      <ResourceSinkGroup>BatteryBlock</ResourceSinkGroup>
      <RequiredPowerInput>1000000</RequiredPowerInput>
      <AdaptibleInput>true</AdaptibleInput>
      <MaxStoredPower>1000</MaxStoredPower>
      <InitialStoredPowerRatio>0</InitialStoredPowerRatio>
      <RechargeMultiplier>0.9</RechargeMultiplier>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_BatteryBlockDefinition">
      <Id>
        <TypeId>BatteryBlock</TypeId>
        <SubtypeId>ArcanePower_EnergyCapacity_Pillar</SubtypeId>
      </Id>
      <DisplayName>Arcane Capacity Module</DisplayName>
      <Description>Full 1x3x1 large-grid pillar; align Up with core Up. Attach to a side-center Energy Core socket, with the connector/forward face toward the core. Requires a matching or stronger front stabilizer. Stores 10000 MWh in this block; removal retains its charge, destruction loses it, new/projected/copied blocks start empty. The core sets bank transfer limits and charge mode.</Description>
      <Icon>Textures/GUI/Icons/ArcanePower/ArcanePower_EnergyCapacity.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Model>Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCapacity.mwm</Model>
      <BlockPairName>ArcanePower_EnergyCapacity_Pillar</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>60</BuildTimeSeconds>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
      <Public>true</Public>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>PoofExplosionCat3</DestroySound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <Size x="1" y="3" z="1" />
      <Center x="0" y="1" z="0" />
      <ModelOffset x="0" y="0" z="0" />
      <Components>
        <Component Subtype="SteelPlate" Count="100" />
        <Component Subtype="Construction" Count="100" />
        <Component Subtype="PowerCell" Count="1500" />
        <Component Subtype="Superconductor" Count="1000" />
        <Component Subtype="Computer" Count="100" />
        <Component Subtype="Motor" Count="20" />
        <Component Subtype="SteelPlate" Count="50" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCapacity_BS1.mwm" />
        <Model BuildPercentUpperBound="0.67" File="Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCapacity_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/energy_f197b0b01b73/ArcanePower_EnergyCapacity_BS3.mwm" />
      </BuildProgressModels>
      <MountPoints>
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="3" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="3" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="3" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="3" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <ResourceSourceGroup>Battery</ResourceSourceGroup>
      <MaxPowerOutput>2000000</MaxPowerOutput>
      <ResourceSinkGroup>BatteryBlock</ResourceSinkGroup>
      <RequiredPowerInput>1000000</RequiredPowerInput>
      <AdaptibleInput>true</AdaptibleInput>
      <MaxStoredPower>10000</MaxStoredPower>
      <InitialStoredPowerRatio>0</InitialStoredPowerRatio>
      <RechargeMultiplier>0.9</RechargeMultiplier>
    </Definition>
