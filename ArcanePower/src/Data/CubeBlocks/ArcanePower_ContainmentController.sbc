<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_ContainmentController</SubtypeId>
      </Id>
      <DisplayName>Arcane Containment Controller</DisplayName>
      <Icon>Textures/GUI/Icons/ArcaneContainmentController.dds</Icon>
      <Description>Attach directly to either reactor side socket. Two standard controllers deploy two rings at 1x tile speed with 80% fuel efficiency and support Aether.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/ArcanePower_ContainmentController_rc357e6ac302d.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="240" />
        <Component Subtype="Construction" Count="150" />
        <Component Subtype="MetalGrid" Count="40" />
        <Component Subtype="SmallTube" Count="80" />
        <Component Subtype="Superconductor" Count="300" />
        <Component Subtype="Computer" Count="150" />
        <Component Subtype="Motor" Count="40" />
        <Component Subtype="SteelPlate" Count="60" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <BlockPairName>ArcanePower_ContainmentController</BlockPairName>
      <EdgeType>Light</EdgeType>
      <Upgrades>
        <MyUpgradeModuleInfo>
          <UpgradeType>ArcaneContainment</UpgradeType>
          <Modifier>1</Modifier>
          <ModifierType>Additive</ModifierType>
        </MyUpgradeModuleInfo>
        <MyUpgradeModuleInfo>
          <UpgradeType>ArcaneControllerCount</UpgradeType>
          <Modifier>1</Modifier>
          <ModifierType>Additive</ModifierType>
        </MyUpgradeModuleInfo>
      </Upgrades>
      <PrimarySound>BlockModuleProductivity</PrimarySound>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>1</PCU>
      <IsAirTight>false</IsAirTight>
      <MountPoints>
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models/Cubes/large/ArcanePower_ContainmentController_BS1_rfe8da49a1eda.mwm" />
        <Model BuildPercentUpperBound="0.67" File="Models/Cubes/large/ArcanePower_ContainmentController_BS2_r5f52f80a2aa2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/ArcanePower_ContainmentController_BS3_r2381594d03c6.mwm" />
      </BuildProgressModels>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>ArcanePower_AdvancedContainmentController</SubtypeId>
      </Id>
      <DisplayName>Arcane Advanced Containment Controller</DisplayName>
      <Icon>Textures/GUI/Icons/ArcaneAdvancedContainmentController.dds</Icon>
      <Description>Two working controllers are required. Standard + advanced: three rings, 1.5x tile speed, 90% efficiency, supports Aether/Helion. Two advanced: four rings, 2x tile speed, 99% efficiency, supports all fuels.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models/Cubes/large/ArcanePower_AdvancedContainmentController_r3e8b09710491.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="480" />
        <Component Subtype="Construction" Count="300" />
        <Component Subtype="MetalGrid" Count="80" />
        <Component Subtype="SmallTube" Count="160" />
        <Component Subtype="Superconductor" Count="3000" />
        <Component Subtype="Computer" Count="500" />
        <Component Subtype="Motor" Count="80" />
        <Component Subtype="SteelPlate" Count="120" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <BlockPairName>ArcanePower_AdvancedContainmentController</BlockPairName>
      <EdgeType>Light</EdgeType>
      <Upgrades>
        <MyUpgradeModuleInfo>
          <UpgradeType>ArcaneContainment</UpgradeType>
          <Modifier>2</Modifier>
          <ModifierType>Additive</ModifierType>
        </MyUpgradeModuleInfo>
        <MyUpgradeModuleInfo>
          <UpgradeType>ArcaneControllerCount</UpgradeType>
          <Modifier>1</Modifier>
          <ModifierType>Additive</ModifierType>
        </MyUpgradeModuleInfo>
      </Upgrades>
      <PrimarySound>BlockModuleProductivity</PrimarySound>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>1</PCU>
      <IsAirTight>false</IsAirTight>
      <MountPoints>
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models/Cubes/large/ArcanePower_AdvancedContainmentController_BS1_r015a374b7905.mwm" />
        <Model BuildPercentUpperBound="0.67" File="Models/Cubes/large/ArcanePower_AdvancedContainmentController_BS2_r61b1e10ce2ff.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/ArcanePower_AdvancedContainmentController_BS3_r2c8e65a36e39.mwm" />
      </BuildProgressModels>
    </Definition>
  </CubeBlocks>
</Definitions>