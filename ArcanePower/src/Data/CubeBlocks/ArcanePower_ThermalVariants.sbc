        <Block Type="MyObjectBuilder_UpgradeModule" Subtype="ArcanePower_Thermal_PrimaryCross" />
        <Block Type="MyObjectBuilder_UpgradeModule" Subtype="ArcanePower_Thermal_PrimaryRollAdapter" />
        <Block Type="MyObjectBuilder_UpgradeModule" Subtype="ArcanePower_Thermal_PrimaryEndCap" />
        <Block Type="MyObjectBuilder_UpgradeModule" Subtype="ArcanePower_Thermal_PrimaryReactorAdapter" />
      </Blocks>
    </BlockVariantGroup>
    <BlockVariantGroup>
