        <Block Type="MyObjectBuilder_UpgradeModule" Subtype="ArcanePower_Thermal_PrimaryStraight" />
        <Block Type="MyObjectBuilder_UpgradeModule" Subtype="ArcanePower_Thermal_PrimaryElbow" />
