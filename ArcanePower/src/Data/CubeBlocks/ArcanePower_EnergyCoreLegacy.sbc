<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_BatteryBlockDefinition">
      <Id>
        <TypeId>BatteryBlock</TypeId>
        <SubtypeId>ArcanePower_EnergyCore</SubtypeId>
      </Id>
      <DisplayName>Arcane Energy Core (legacy compact)</DisplayName>
      <Description>Preserved compact block for existing saves.
New construction uses the three-cell pillar installation.


INSTALLATION
Compact 3x3x3 storage controller.
Side sockets: capacity; rear: transfer; top: stabilizer.
Modules must face the core.

STORAGE
Base 1,000 MWh / 10 GW; capacities add 10,000 or 100,000 MWh.
Transfer modules raise the bank ceiling to 100 GW / 1 TW.
Standard/advanced stabilizers support matching or lower tier modules.

CHARGING
Native Auto/Recharge/Discharge.
Starts empty; 90% charge efficiency.

RESERVE
Default 10% emergency reserve; Custom Data [ArcaneEnergyCore] ReservePercent=10, EmergencySupport=true.
Recharge switches visibly to Auto for reactor startup/cooldown/venting and stays Auto.
Stored-charge upkeep rises with fill; stabilizers reduce loss.

ABILITIES
Terminal/toolbar: surge all affordable jump drives in 5 seconds at 90% efficiency, with batch-scaled discharge boost and 25% extra base recovery per additional drive, or double discharge for 10 seconds.
Shared recovery; reserve protected.

UPKEEP
Passive loss continues while disabled or detached.</Description>
      <Icon>Textures/GUI/Icons/ArcanePower/Compact/ArcanePower_EnergyCore.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Model>Models/Cubes/large/energy_109d27f880a0/ArcanePower_EnergyCore.mwm</Model>
      <BlockPairName>ArcanePower_EnergyCore</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>180</BuildTimeSeconds>
      <PCU>100</PCU>
      <IsAirTight>false</IsAirTight>
      <Public>false</Public>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>PoofExplosionCat3</DestroySound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <Size x="3" y="3" z="3" />
      <Center x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Components>
        <Component Subtype="SteelPlate" Count="1000" />
        <Component Subtype="Construction" Count="500" />
        <Component Subtype="PowerCell" Count="1200" />
        <Component Subtype="Superconductor" Count="1000" />
        <Component Subtype="Computer" Count="200" />
        <Component Subtype="Motor" Count="80" />
        <Component Subtype="SteelPlate" Count="200" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models/Cubes/large/energy_109d27f880a0/ArcanePower_EnergyCore_BS1.mwm" />
        <Model BuildPercentUpperBound="0.67" File="Models/Cubes/large/energy_109d27f880a0/ArcanePower_EnergyCore_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/energy_109d27f880a0/ArcanePower_EnergyCore_BS3.mwm" />
      </BuildProgressModels>
      <MountPoints>
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="3" EndY="3" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="3" />
      </MountPoints>
      <ResourceSourceGroup>Battery</ResourceSourceGroup>
      <MaxPowerOutput>2000000</MaxPowerOutput>
      <ResourceSinkGroup>BatteryBlock</ResourceSinkGroup>
      <RequiredPowerInput>1000000</RequiredPowerInput>
      <AdaptibleInput>true</AdaptibleInput>
      <MaxStoredPower>1000</MaxStoredPower>
      <InitialStoredPowerRatio>0</InitialStoredPowerRatio>
      <RechargeMultiplier>0.9</RechargeMultiplier>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_BatteryBlockDefinition">
      <Id>
