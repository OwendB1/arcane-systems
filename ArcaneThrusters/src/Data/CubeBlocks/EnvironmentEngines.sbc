      <DisplayName>Arcane Vacuum Triple (Exposed)</DisplayName>
      <Icon>Textures/GUI/Icons/ArcaneThrusters/ArcaneThrusters_VacuumLG.dds</Icon>
      <Description>Hydrogen rocket for orbital transfers. Delivers 8.64 MN in vacuum and 5.76 MN in dense air. Exposed rear mount.</Description>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="3" y="3" z="3"/>
      <ModelOffset x="0" y="0" z="0"/>
