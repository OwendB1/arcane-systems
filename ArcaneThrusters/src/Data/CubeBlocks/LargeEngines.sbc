        <Model BuildPercentUpperBound="0.66" File="Models/Cubes/large/ArcaneThrusters_DrivePriorityLG_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models/Cubes/large/ArcaneThrusters_DrivePriorityLG_BS3.mwm" />
